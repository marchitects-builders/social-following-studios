# NVIDIA hosted NIM
NVIDIA_API_KEY=nvapi-your-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=meta/llama-3.1-70b-instruct

# Meta app webhook verification and signature validation
META_VERIFY_TOKEN=replace-with-a-long-random-value
META_APP_SECRET=replace-with-the-meta-app-secret
META_INSTAGRAM_APP_SECRET=replace-with-the-instagram-app-secret
META_GRAPH_API_VERSION=v26.0
META_INSTAGRAM_GRAPH_API_VERSION=v25.0

# Map each Facebook Page ID to its Page access token.
# Keep this on one line in Vercel.
META_PAGE_ACCESS_TOKENS_JSON={"1051001691422441":"token-for-artists","554581997738729":"token-for-social-following","100666925801808":"token-for-marketing-automation"}

# Optional fallback when only one Page is connected.
# META_PAGE_ACCESS_TOKEN=

# Map Instagram professional account IDs to Instagram user access tokens.
META_INSTAGRAM_ACCESS_TOKENS_JSON={"17841462233763049":"token-for-marchitectsio","17841460118425871":"token-for-social-following","17841480544451772":"token-for-aafccohort"}

# Optional fallback when only one Instagram account is connected.
# META_INSTAGRAM_ACCESS_TOKEN=

# Private control-room access
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Persistent state (free Upstash Redis REST database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace may provide the equivalent aliases instead:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Protects the follow-up processor
CRON_SECRET=replace-with-a-long-random-secret
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
YOCHAT_PUBLIC_URL=https://yochat-messenger-webhook.vercel.app

# Optional: forward qualified leads and handoffs to another system
YOCHAT_EVENT_WEBHOOK_URL=
YOCHAT_EVENT_WEBHOOK_SECRET=
